{
  "name": "OWASP Top 10 Labs",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [80, 4999],
  "portsAttributes": {
    "80": { "label": "Dashboard" },
    "4999": { "label": "Lab Manager API" }
  },
  "postCreateCommand": "pip install --no-cache-dir -r platform/backend/requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-azuretools.vscode-docker"]
    }
  }
}
